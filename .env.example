# ─────────────────────────────────────────────────────────────────────────────
# Construction Platform — Environment Configuration Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Construction Platform"
ENVIRONMENT=development          # development | testing | production
DEBUG=true                       # set to false in production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg dialect required for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/construction_platform

# Connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false                    # set to true to log all SQL (development only)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_real_64_byte_hex_secret_before_deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 hours
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Object Storage (MinIO locally, AWS S3 in production) ─────────────────────
STORAGE_ENDPOINT_URL=http://localhost:9000   # remove this line for real AWS S3
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_NAME=construction-platform
STORAGE_REGION=ap-south-1                   # Mumbai region for Indian customers

# ── Celery Task Queue ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1   # separate DB from cache
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Prometheus ────────────────────────────────────────────────────────────────
# IP allowlist for /metrics endpoint (comma-separated CIDR or IPs)
# Leave empty to allow all (development only)
METRICS_ALLOWED_IPS=[]
